# Локальная конфигурация. Скопируйте в .env и при необходимости измените.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/presentator
REDIS_URL=redis://localhost:6379/0
STORAGE_DIR=storage
LIBREOFFICE_BIN=soffice

# Необязательно: OpenAI-совместимый API (OpenAI, Ollama, LM Studio и др.).
# Без них структура слайдов строится детерминированно из текста.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
