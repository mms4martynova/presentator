{
  "openapi": "3.1.0",
  "info": {
    "title": "Презентатор (Presentation Generator)",
    "version": "1.0.0",
    "description": "## Интеллектуальная система автоматического создания корпоративных презентаций\n\nСистема формирует многостраничные презентации в форматах **PPTX** и **PDF** по текстовому описанию или структурированным данным. Поддерживаются корпоративные шаблоны с версионированием, AI Visual Advisor, LLM-генерация структуры и MCP-интеграция.\n\n### Аутентификация\nВсе защищённые запросы требуют API-ключ в заголовке `X-API-Key`.\n\n### Режимы генерации\n- `async` — задача ставится в очередь, ответ `202 Accepted`.\n- `sync` — генерация до 5 слайдов, ответ `200 OK`."
  },
  "servers": [
    {
      "url": "/",
      "description": "Текущий опубликованный сайт или reverse proxy"
    }
  ],
  "tags": [
    { "name": "Аутентификация", "description": "Проверка API-ключа и получение профиля пользователя." },
    { "name": "Задачи", "description": "Создание задач генерации презентаций, отслеживание статуса, история генераций, повторная сборка и скачивание результатов в PPTX/PDF." },
    { "name": "Шаблоны", "description": "Управление корпоративными PPTX-шаблонами: загрузка, версионирование, откат, предпросмотр и удаление." },
    { "name": "AI Visual Advisor", "description": "Анализ данных слайда и рекомендация оптимального способа визуализации." },
    { "name": "MCP", "description": "MCP-сервер Streamable HTTP для интеграции с внешними ИИ-агентами." },
    { "name": "Служебное", "description": "Проверка работоспособности сервиса." }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["Служебное"],
        "summary": "Проверка работоспособности",
        "description": "Возвращает `status=ok`, если сервис запущен и отвечает на запросы.",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Сервис работает",
            "content": { "application/json": { "schema": { "type": "object", "required": ["status"], "properties": { "status": { "type": "string", "example": "ok" } } } } }
          }
        }
      }
    },
    "/api/v1/me": {
      "get": {
        "tags": ["Аутентификация"],
        "summary": "Профиль пользователя",
        "description": "Возвращает идентификатор и имя пользователя, которому принадлежит API-ключ.",
        "operationId": "read_me",
        "security": [{ "APIKeyHeader": [] }],
        "responses": {
          "200": { "description": "Профиль пользователя", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/MeOut" } } } },
          "401": { "description": "Неверный или отсутствующий API-ключ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "422": { "description": "Ошибка валидации входных данных", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } }
        }
      }
    },
    "/api/v1/advisor/recommend": {
      "post": {
        "tags": ["AI Visual Advisor"],
        "summary": "Рекомендация типа визуализации для слайда",
        "description": "Анализирует описание одного слайда и рекомендует тип визуализации. Если `type` задан явно, он имеет приоритет.",
        "operationId": "recommend_visualization",
        "security": [{ "APIKeyHeader": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/SlideSpec" } } } },
        "responses": {
          "200": { "description": "Рекомендация", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/RecommendationOut" } } } },
          "401": { "description": "Неверный или отсутствующий API-ключ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "422": { "description": "Ошибка валидации входных данных", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } }
        }
      }
    },
    "/api/v1/tasks": {
      "post": {
        "tags": ["Задачи"],
        "summary": "Создать задачу генерации презентации",
        "description": "Создаёт задачу на основе текстового описания или структурированных слайдов. В `async`-режиме задача ставится в очередь, а в `sync`-режиме выполняется сразу для презентаций до 5 слайдов.",
        "operationId": "create_task",
        "security": [{ "APIKeyHeader": [] }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskCreate" } } } },
        "responses": {
          "200": { "description": "Задача завершена в синхронном режиме", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskOut" } } } },
          "202": { "description": "Задача поставлена в очередь", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskOut" } } } },
          "401": { "description": "Неверный или отсутствующий API-ключ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "422": { "description": "Ошибка валидации входных данных", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } }
        }
      },
      "get": {
        "tags": ["Задачи"],
        "summary": "История генераций",
        "description": "Возвращает до 50 последних задач текущего пользователя, отсортированных от новых к старым.",
        "operationId": "list_tasks",
        "security": [{ "APIKeyHeader": [] }],
        "responses": {
          "200": { "description": "Список задач", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/TaskSummary" } } } } },
          "401": { "description": "Неверный или отсутствующий API-ключ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "422": { "description": "Ошибка валидации входных данных", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } }
        }
      }
    },
    "/api/v1/tasks/{task_id}": {
      "get": {
        "tags": ["Задачи"],
        "summary": "Статус задачи",
        "description": "Возвращает статус, прогресс, структуру слайдов и наличие готовых файлов. Статусы: `queued`, `processing`, `completed`, `failed`.",
        "operationId": "read_task",
        "security": [{ "APIKeyHeader": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TaskId" }],
        "responses": {
          "200": { "description": "Задача", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskOut" } } } },
          "401": { "description": "Неверный или отсутствующий API-ключ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "404": { "description": "Задача не найдена", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "422": { "description": "Ошибка валидации входных данных", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } }
        }
      }
    },
    "/api/v1/tasks/{task_id}/rebuild": {
      "post": {
        "tags": ["Задачи"],
        "summary": "Повторная сборка с изменёнными параметрами",
        "description": "Создаёт новую задачу на основе существующей. Не переданные поля наследуются от родительской задачи.",
        "operationId": "rebuild",
        "security": [{ "APIKeyHeader": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TaskId" }],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskRebuild" } } } },
        "responses": {
          "202": { "description": "Новая задача поставлена в очередь", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TaskOut" } } } },
          "401": { "description": "Неверный или отсутствующий API-ключ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "404": { "description": "Родительская задача не найдена", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "422": { "description": "Ошибка валидации входных данных", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } }
        }
      }
    },
    "/api/v1/tasks/{task_id}/result": {
      "get": {
        "tags": ["Задачи"],
        "summary": "Скачать готовую презентацию (PPTX или PDF)",
        "description": "Скачивает готовый файл. Параметр `format`: `pptx` или `pdf`; PDF доступен, если задача создана с `want_pdf=true`.",
        "operationId": "download_result",
        "security": [{ "APIKeyHeader": [] }],
        "parameters": [
          { "$ref": "#/components/parameters/TaskId" },
          { "name": "format", "in": "query", "required": false, "description": "Формат файла", "schema": { "type": "string", "enum": ["pptx", "pdf"], "default": "pptx" } }
        ],
        "responses": {
          "200": { "description": "Бинарный файл презентации", "content": { "application/vnd.openxmlformats-officedocument.presentationml.presentation": { "schema": { "type": "string", "format": "binary" } }, "application/pdf": { "schema": { "type": "string", "format": "binary" } } } },
          "401": { "description": "Неверный или отсутствующий API-ключ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "404": { "description": "Файл в выбранном формате ещё не готов", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "422": { "description": "Ошибка валидации входных данных", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } }
        }
      }
    },
    "/api/v1/templates": {
      "get": {
        "tags": ["Шаблоны"],
        "summary": "Список шаблонов",
        "description": "Возвращает все шаблоны текущего пользователя с историей версий.",
        "operationId": "list_templates",
        "security": [{ "APIKeyHeader": [] }],
        "responses": {
          "200": { "description": "Список шаблонов", "content": { "application/json": { "schema": { "type": "array", "items": { "$ref": "#/components/schemas/TemplateOut" } } } } },
          "401": { "description": "Неверный или отсутствующий API-ключ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "404": { "description": "Шаблон или версия не найдена", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "413": { "description": "Файл превышает 50 МБ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "422": { "description": "Файл не является PPTX или имеет неверную структуру", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "503": { "description": "Ошибка конвертации в PDF", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } }
        }
      },
      "post": {
        "tags": ["Шаблоны"],
        "summary": "Загрузить PPTX-шаблон",
        "description": "Создаёт новый шаблон и загружает его первую активную версию. Поддерживаются только PPTX-файлы размером до 50 МБ.",
        "operationId": "upload_template",
        "security": [{ "APIKeyHeader": [] }],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "$ref": "#/components/schemas/UploadTemplateForm" } } } },
        "responses": {
          "201": { "description": "Шаблон создан", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TemplateOut" } } } },
          "401": { "description": "Неверный или отсутствующий API-ключ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "404": { "description": "Шаблон или версия не найдена", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "413": { "description": "Файл превышает 50 МБ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "422": { "description": "Файл не является PPTX или имеет неверную структуру", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "503": { "description": "Ошибка конвертации в PDF", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } }
        }
      }
    },
    "/api/v1/templates/{template_id}": {
      "get": {
        "tags": ["Шаблоны"],
        "summary": "Информация о шаблоне и его версиях",
        "operationId": "read_template",
        "security": [{ "APIKeyHeader": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TemplateId" }],
        "responses": {
          "200": { "description": "Шаблон", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TemplateOut" } } } },
          "401": { "description": "Неверный или отсутствующий API-ключ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "404": { "description": "Шаблон или версия не найдена", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "422": { "description": "Ошибка валидации входных данных", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } }
        }
      },
      "delete": {
        "tags": ["Шаблоны"],
        "summary": "Удалить шаблон",
        "description": "Удаляет шаблон, его версии и бинарные файлы. Задачи, ссылающиеся на версии, сохраняются.",
        "operationId": "remove_template",
        "security": [{ "APIKeyHeader": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TemplateId" }],
        "responses": {
          "204": { "description": "Шаблон удалён" },
          "401": { "description": "Неверный или отсутствующий API-ключ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "404": { "description": "Шаблон или версия не найдена", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "422": { "description": "Ошибка валидации входных данных", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } }
        }
      }
    },
    "/api/v1/templates/{template_id}/versions": {
      "post": {
        "tags": ["Шаблоны"],
        "summary": "Загрузить новую версию шаблона",
        "description": "Добавляет новую версию PPTX-файла. Новая версия автоматически становится активной, предыдущие деактивируются.",
        "operationId": "upload_version",
        "security": [{ "APIKeyHeader": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TemplateId" }],
        "requestBody": { "required": true, "content": { "multipart/form-data": { "schema": { "$ref": "#/components/schemas/UploadVersionForm" } } } },
        "responses": {
          "200": { "description": "Новая версия загружена", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TemplateOut" } } } },
          "401": { "description": "Неверный или отсутствующий API-ключ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "404": { "description": "Шаблон или версия не найдена", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "413": { "description": "Файл превышает 50 МБ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "422": { "description": "Файл не является PPTX или имеет неверную структуру", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "503": { "description": "Ошибка конвертации в PDF", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } }
        }
      }
    },
    "/api/v1/templates/{template_id}/versions/{version_id}/activate": {
      "post": {
        "tags": ["Шаблоны"],
        "summary": "Назначить активную версию (откат)",
        "description": "Делает указанную версию активной и деактивирует остальные.",
        "operationId": "activate_version",
        "security": [{ "APIKeyHeader": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TemplateId" }, { "$ref": "#/components/parameters/VersionId" }],
        "responses": {
          "200": { "description": "Версия активирована", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/TemplateOut" } } } },
          "401": { "description": "Неверный или отсутствующий API-ключ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "404": { "description": "Шаблон или версия не найдена", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "422": { "description": "Ошибка валидации входных данных", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } }
        }
      }
    },
    "/api/v1/templates/{template_id}/versions/{version_id}/preview": {
      "get": {
        "tags": ["Шаблоны"],
        "summary": "Предпросмотр версии в PDF",
        "description": "Конвертирует указанную версию PPTX-шаблона в PDF и возвращает его для предпросмотра в браузере.",
        "operationId": "preview_version",
        "security": [{ "APIKeyHeader": [] }],
        "parameters": [{ "$ref": "#/components/parameters/TemplateId" }, { "$ref": "#/components/parameters/VersionId" }],
        "responses": {
          "200": { "description": "PDF предпросмотра", "content": { "application/pdf": { "schema": { "type": "string", "format": "binary" } } } },
          "401": { "description": "Неверный или отсутствующий API-ключ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "404": { "description": "Шаблон или версия не найдена", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "413": { "description": "Файл превышает 50 МБ", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "422": { "description": "Файл не является PPTX или имеет неверную структуру", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } },
          "503": { "description": "Ошибка конвертации в PDF", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ErrorOut" } } } }
        }
      }
    },
    "/api/v1/mcp": {
      "post": {
        "tags": ["MCP"],
        "summary": "MCP-сервер (Streamable HTTP)",
        "description": "Единая точка входа MCP-клиентов. Реализует JSON-RPC 2.0 поверх HTTP. Поддерживает `initialize`, `notifications/initialized`, `tools/list`, `tools/call`, `ping` и `logging/setLevel`. При `Accept: text/event-stream` отвечает SSE-стримом.",
        "operationId": "mcp_endpoint",
        "security": [{ "APIKeyHeader": [] }],
        "parameters": [
          { "name": "Accept", "in": "header", "required": false, "schema": { "type": "string", "example": "application/json, text/event-stream" } },
          { "name": "Mcp-Session-Id", "in": "header", "required": false, "schema": { "type": "string" } }
        ],
        "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JsonRpcRequest" } } } },
        "responses": {
          "200": { "description": "JSON-RPC результат или SSE-событие", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JsonRpcResponse" } }, "text/event-stream": { "schema": { "type": "string" } } } },
          "202": { "description": "JSON-RPC notification принята" },
          "204": { "description": "Инициализация подтверждена" },
          "400": { "description": "Сессия отсутствует или истекла", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JsonRpcResponse" } } } }
        }
      },
      "get": {
        "tags": ["MCP"],
        "summary": "MCP SSE-stream",
        "description": "Открывает SSE-стрим для server-to-client уведомлений. Требует валидный `Mcp-Session-Id`.",
        "operationId": "mcp_sse_stream",
        "security": [{ "APIKeyHeader": [] }],
        "parameters": [{ "name": "Mcp-Session-Id", "in": "header", "required": false, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "SSE-стрим", "content": { "text/event-stream": { "schema": { "type": "string" } } } },
          "400": { "description": "Сессия отсутствует или истекла", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/JsonRpcResponse" } } } }
        }
      },
      "delete": {
        "tags": ["MCP"],
        "summary": "Завершить MCP-сессию",
        "description": "Удаляет сессию по `Mcp-Session-Id`.",
        "operationId": "mcp_close_session",
        "security": [{ "APIKeyHeader": [] }],
        "parameters": [{ "name": "Mcp-Session-Id", "in": "header", "required": false, "schema": { "type": "string" } }],
        "responses": {
          "204": { "description": "Сессия завершена" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "APIKeyHeader": { "type": "apiKey", "in": "header", "name": "X-API-Key", "description": "API-ключ пользователя" }
    },
