      "TaskRebuild": { "type": "object", "properties": { "title": { "anyOf": [{ "type": "string", "minLength": 1, "maxLength": 200 }, { "type": "null" }], "default": null }, "text": { "anyOf": [{ "type": "string", "maxLength": 50000 }, { "type": "null" }], "default": null }, "slides": { "anyOf": [{ "type": "array", "maxItems": 40, "items": { "$ref": "#/components/schemas/SlideSpec" } }, { "type": "null" }], "default": null }, "slides_count": { "anyOf": [{ "type": "integer", "minimum": 1, "maximum": 40 }, { "type": "null" }], "default": null }, "language": { "anyOf": [{ "type": "string", "enum": ["ru", "en"] }, { "type": "null" }], "default": null }, "audience": { "anyOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }], "default": null }, "tone": { "anyOf": [{ "type": "string", "maxLength": 200 }, { "type": "null" }], "default": null }, "template_id": { "anyOf": [{ "type": "integer" }, { "type": "null" }], "default": null }, "want_pdf": { "anyOf": [{ "type": "boolean" }, { "type": "null" }], "default": null } } },
      "TaskOut": { "type": "object", "required": ["id", "title", "status", "progress", "error", "parent_task_id", "template_version_id", "want_pdf", "request", "outline", "has_pptx", "has_pdf", "created_at", "updated_at"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "status": { "type": "string" }, "progress": { "type": "integer" }, "error": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "parent_task_id": { "anyOf": [{ "type": "string" }, { "type": "null" }] }, "template_version_id": { "anyOf": [{ "type": "integer" }, { "type": "null" }] }, "want_pdf": { "type": "boolean" }, "request": { "type": "object", "additionalProperties": true }, "outline": { "anyOf": [{ "type": "array", "items": { "$ref": "#/components/schemas/SlideSpec" } }, { "type": "null" }] }, "has_pptx": { "type": "boolean" }, "has_pdf": { "type": "boolean" }, "created_at": { "type": "string", "format": "date-time" }, "updated_at": { "type": "string", "format": "date-time" } } },
      "TaskSummary": { "type": "object", "required": ["id", "title", "status", "progress", "want_pdf", "has_pptx", "has_pdf", "created_at"], "properties": { "id": { "type": "string" }, "title": { "type": "string" }, "status": { "type": "string" }, "progress": { "type": "integer" }, "want_pdf": { "type": "boolean" }, "has_pptx": { "type": "boolean" }, "has_pdf": { "type": "boolean" }, "created_at": { "type": "string", "format": "date-time" } } },
